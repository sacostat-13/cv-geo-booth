# Copy to .env for local work, or set these as environment variables in
# Netlify: Site configuration → Environment variables.
# Everything is optional — with none of it set the site runs in demo mode.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

BOOTH_EVENT_NAME=MozFest 2026
BOOTH_NAME=Common Voice
BOOTH_RESET_DAILY=false
BOOTH_POLL_MS=3000
BOOTH_PROJECTION=globe
BOOTH_HIGHLIGHT_MS=10000
BOOTH_PIN_MAX=40

# Only if the phone page is NOT served from this same site. Left unset, the
# screen points the QR code at its own origin.
# BOOTH_PHONE_URL=https://voices.example.org/
