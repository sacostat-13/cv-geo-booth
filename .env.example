# Copy to .env for local work, or set these in Netlify:
# Site configuration -> Environment variables. Everything is optional —
# with none of it set the booth runs with the defaults in defaults.js.
# DEPLOY.md has the full table with what each one does.

BOOTH_EVENT_NAME=MozFest 2026
# Change this for a rehearsal so practice runs do not land on the real board.
BOOTH_EVENT_SLUG=mozfest-2026

# BOOTH_QUESTIONS=5
# BOOTH_ANSWER_MS=20000
# BOOTH_REVEAL_MS=3500
# BOOTH_CLIP_SECS=6
# BOOTH_REPLAYS=2
# Where both pads sit between visitors, and what the levels are worth.
# BOOTH_LEVEL=normal
# BOOTH_MULT_NORMAL=2
# BOOTH_MULT_HARD=5
# BOOTH_PERFECT_BONUS=2
# BOOTH_DUEL_WINDOW_MS=3500
# BOOTH_DUEL_READY_MS=5000
# BOOTH_POLL_MS=1000
# BOOTH_IDLE_POLL_MS=3000
# BOOTH_HOUR_TOP=10
# BOOTH_DAY_TOP=3
# BOOTH_LANGUAGE_URL=https://commonvoice.mozilla.org/{locale}/datasets
